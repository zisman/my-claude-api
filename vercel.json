{
  "buildCommand": "npm install --prefix backend",
  "outputDirectory": "backend",
  "devCommand": "cd backend && npm run dev",
  "env": {
    "ANTHROPIC_API_KEY": "@ANTHROPIC_API_KEY",
    "PORT": "3001"
  },
  "functions": {
    "backend/src/index.js": {
      "runtime": "nodejs18.x"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/backend/src/index.js"
    }
  ]
}